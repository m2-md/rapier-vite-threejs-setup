{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // REQUIRED: @dimforge/rapier3d has no "exports" field. With "node16"
    // type resolution breaks; "bundler" reads the package's "module"/"types" field.
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "tests",
    "size",
    "vite.config.ts",
    "vite.config.compat.ts",
    "vite.config.tla.ts",
    "vite.config.inline-trap.ts",
    "vitest.config.ts"
  ]
}
